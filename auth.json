{
  "index_patterns": [
    "auth-*"
  ],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "event.code": {
          "type": "long"
        },
        "event.provider": {
          "type": "keyword"
        },
        "host.ip": {
          "type": "ip"
        },
        "host.name": {
          "type": "keyword"
        },
        "logon.type": {
          "type": "keyword"
        },
        "message": {
          "type": "text"
        },
        "process.command_line": {
          "type": "keyword",
          "ignore_above": 2048
        },
        "process.name": {
          "type": "keyword"
        },
        "process.parent.name": {
          "type": "keyword"
        },
        "process.pid": {
          "type": "long"
        },
        "source.ip": {
          "type": "ip"
        },
        "source.port": {
          "type": "long"
        },
        "user.domain": {
          "type": "keyword"
        },
        "user.name": {
          "type": "keyword"
        },
        "user.target.name": {
          "type": "keyword"
        },
        "event.action": {
          "type": "keyword"
        },
        "event.category": {
          "type": "keyword"
        },
        "event.outcome": {
          "type": "keyword"
        },
        "event.type": {
          "type": "keyword"
        },
        "winlog.channel": {
          "type": "keyword"
        },
        "winlog.event_data.CredentialType": {
          "type": "keyword"
        },
        "winlog.event_data.ObjectServer": {
          "type": "keyword"
        },
        "winlog.event_data.ObjectType": {
          "type": "keyword"
        },
        "winlog.event_data.PrivilegeList": {
          "type": "keyword"
        },
        "winlog.event_data.ProcessName": {
          "type": "keyword"
        },
        "winlog.event_data.Properties": {
          "type": "keyword"
        },
        "winlog.event_data.ServiceName": {
          "type": "keyword"
        },
        "winlog.event_data.Status": {
          "type": "keyword"
        },
        "winlog.event_data.SubStatus": {
          "type": "keyword"
        },
        "winlog.event_data.TargetUserName": {
          "type": "keyword"
        },
        "winlog.event_data.TaskName": {
          "type": "keyword"
        },
        "winlog.event_data.TicketEncryptionType": {
          "type": "keyword"
        },
        "winlog.event_data.TicketLifetimeSeconds": {
          "type": "long"
        },
        "winlog.event_data.TicketOptions": {
          "type": "keyword"
        }
      }
    }
  }
}
